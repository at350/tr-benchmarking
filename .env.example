# Copy to .env at the repository root. trbench commands load it from the current directory or any parent.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Optional
ENABLE_GROK4=false          # add xai/grok-4 to the IRAC benchmark (expensive)
LSH_MOCK_EMBEDDINGS=        # set to 1 to use random vectors instead of the embedding model (tests, smoke runs)
OPENAI_BASE_URL=            # alternative OpenAI-compatible endpoint (rubric-automation --provider openai)

# rubric-automation only. It reads these from the shell environment, not from this file:
#   export ANTHROPIC_API_KEY=...   (or CLAUDE_API_KEY), optional ANTHROPIC_BASE_URL
