# Copy to frontend/.env.local. The portal's judge and drafting features call these APIs;
# the browsing views (saved runs, outlines, datasets) work without any key.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: extra hosts allowed to reach `next dev`, comma-separated (LAN IP, tunnel domain).
ALLOWED_DEV_ORIGINS=

# Optional: Python interpreter that has `trbench` installed. Default: <repo>/.venv/bin/python3, then
# python3 from PATH. Set this when the package lives in a conda, uv, pyenv, or system environment.
TRBENCH_PYTHON=
